
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
# Small/fast model used for the background patient-data extraction pass
# (server/lib/patientExtraction.js) — no reason to spend the big model's
# budget on structured JSON extraction.
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
# whisper-large-v3 (not the -turbo variant) has meaningfully better Hindi/
# Indian-language accuracy — worth the extra latency here since this is
# reading back numbers (vitals) that matter to get right.
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=hi

# --- TTS provider ---
# Your voice ID (4459a9a5-69d6-4680-b970-e13dc51845b6) is a Cartesia voice
# ID — Cartesia is the provider to use here, not ElevenLabs.
TTS_PROVIDER=cartesia
TTS_API_KEY=your_cartesia_api_key_here
TTS_VOICE_ID=4459a9a5-69d6-4680-b970-e13dc51845b6
# ISO-639-1 code Cartesia should speak the transcript in. "hi" = Hindi.
# Cartesia's sonic-2/sonic-3 models support en, hi, and several others —
# if your assistant replies in English (patient spoke English), the
# frontend still sends whatever language the reply was written in; this
# only sets the *default* voice language.
TTS_LANGUAGE=hi
CARTESIA_MODEL_ID=sonic-2

# --- Server ---
PORT=3000

# --- Session behavior ---
SLEEP_TIMEOUT_MS=9000

# --- Integration with your main project ---
# If the main project and this widget are served from different origins,
# set this so postMessage calls only go to/accept that origin instead of
# "*". Leave blank during local development.
HOST_APP_ORIGIN=
